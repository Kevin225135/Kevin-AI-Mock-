# Optional DashScope model configuration.
# Copy this file to optional-model.env and add a key owned by the tester.
# Never send a ZIP that contains a real API key to an untrusted person.
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen3.5-plus
RAG_LLM_ENABLED=true
RAG_WEB_SEARCH_ENABLED=false
RAG_PROVIDER_TIMEOUT_MS=45000

